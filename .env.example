# llm-api-gateway — environment configuration
# Copy this file to .env and fill in your values (loaded on startup).

# Bearer token that API clients must send (Authorization: Bearer <token>).
# REQUIRED — the server refuses to start without it.
# Example test value — replace with your own secret.
AUTH_TOKEN=my-test-token

# Z.AI JWT token (chat.z.ai → DevTools → Local Storage → "token").
# Empty → guest session (limited model set, no image input).
ZAI_TOKEN=

# Server
PORT=5082
HOST=0.0.0.0

# Logging: debug | info | warn | error
LOG_LEVEL=info

# ── Z.AI account pool ──
# USE_ACCOUNT_POOL=true → ZAI_TOKENS_FILE is used as an account pool:
# one JWT per line ('#' comments and blank lines OK). Accounts are validated
# at startup against /api/v1/auths/; banned or expired ones are skipped,
# and chat-level 401 triggers mid-session rotation.
# USE_ACCOUNT_POOL=false → single ZAI_TOKEN above.
USE_ACCOUNT_POOL=false
ZAI_TOKENS_FILE=zai_tokens.txt

# Request timeout in milliseconds (default 300000 = 5 minutes)
# TIMEOUT=300000

# Claude Desktop mode: /v1/models returns claude-* aliases and /v1/messages
# accepts claude model names
# CLAUDE_DESKTOP=false

# Anthropic /v1/messages: minimum gap between Z.AI sends in ms
# ANTHROPIC_ZAI_MIN_MS=1500
